<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EAXGE EAX</title>

<style>
body {
  margin: 0;
  background: #000000;
  color: #f0f0f0;
  font-family: system-ui, sans-serif;
  display: grid;
  place-items: center;
  min-height: 100vh;
  text-align: center;
}

main {
  padding: 30px;
}

h1 {
  font-size: 48px;
  margin-bottom: 20px;
}

p {
  margin: 12px 0;
  opacity: 0.10;
}

#clue {
  margin-top: 25px;
}
</style>
</head>

<body>

<main>
  <h1>☀</h1>

  <p id="status">can YOU prove it.</p>

  <p id="clue"></p>
</main>

<script>
const DRIVE_1 =
"https://drive.google.com/drive/folders/1valQtwpUoLt5QxvNnAakI_NV4Si_K7vv2_ZXUbYL1OomYRB6t1O0kuFBXlix7EoZ49U4brI3";

const DRIVE_2 =
"https://drive.google.com/drive/folders/1vCzFLpL1ckXtT_gsUeu6teF2Yjxga9_q";

const status = document.getElementById("status");
const clue = document.getElementById("clue");

let redirected = false;

function checkOrientation() {

  const angle = screen.orientation?.angle ?? 0;

  /*
    HP
    0° = normal
    270° = diputar ke kiri
  */

  if (angle === 270) {

    status.textContent = "can YOU price it";
    clue.textContent = "wrong";

    document.body.style.background = "#5D0D02";

    if (!redirected) {
      redirected = true;

      setTimeout(() => {
        window.location.href = DRIVE_2;
      }, 700);
    }

  } else if (angle === 0) {

    status.textContent = "can YOU prove it.";
    clue.textContent = "wrong";

    document.body.style.background = "#000000";

    if (!redirected) {
      redirected = true;

      setTimeout(() => {
        window.location.href = DRIVE_1;
      }, 700);
    }
  }
}


/*
  CLUE UNTUK PC
*/

if (/Android|iPhone|iPad/i.test(navigator.userAgent)) {
  clue.textContent = "wrong";
} else {
  clue.textContent = "...";
}


/*
  CEK SAAT HALAMAN DIBUKA
*/

setTimeout(checkOrientation, 300);


/*
  CEK SAAT HP DIPUTAR
*/

screen.orientation?.addEventListener(
  "change",
  checkOrientation
);

window.addEventListener(
  "resize",
  checkOrientation
);

</script>

</body>
</html>
