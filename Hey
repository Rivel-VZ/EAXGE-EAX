<script>
const DRIVE_1 =
"https://drive.google.com/drive/folders/1valQtwpUoLt5QxvNnAakI_NV4Si_K7vv2_ZXUbYL1OomYRB6t1O0kuFBXlix7EoZ49U4brI3";

const DRIVE_2 =
"https://drive.google.com/drive/folders/1vCzFLpL1ckXtT_gsUeu6teF2Yjxga9_q";

const status = document.getElementById("status");
const clue = document.getElementById("clue");

let lastOrientation = null;
let redirected = false;

function getOrientation() {

  if (screen.orientation) {
    return screen.orientation.angle;
  }

  if (typeof window.orientation === "number") {
    return window.orientation;
  }

  return 0;
}

function checkOrientation() {

  const angle = getOrientation();

  console.log("ORIENTATION:", angle);

  /*
    TEGAK
  */

  if (angle === 0 || angle === 180) {

    status.textContent = "can YOU prove it.";
    clue.textContent = "wrong";

    document.body.style.background = "#000000";

    return;
  }


  /*
    MIRING KIRI
  */

  if (angle === 270 || angle === -90) {

    status.textContent = "can YOU price it";
    clue.textContent = "wrong";

    document.body.style.background = "#5D0D02";

    if (
      lastOrientation !== null &&
      lastOrientation !== angle &&
      !redirected
    ) {

      redirected = true;

      setTimeout(() => {
        window.location.href = DRIVE_2;
      }, 700);

    }

    return;
  }


  /*
    MIRING KANAN
  */

  if (angle === 90) {

    status.textContent = "can YOU price it";
    clue.textContent = "wrong";

    document.body.style.background = "#5D0D02";

    return;
  }

  lastOrientation = angle;
}


/*
  DETEKSI PERTAMA
*/

lastOrientation = getOrientation();
checkOrientation();


/*
  SAAT HP DIPUTAR
*/

if (screen.orientation) {

  screen.orientation.addEventListener(
    "change",
    () => {
      checkOrientation();
      lastOrientation = getOrientation();
    }
  );

}


/*
  FALLBACK ANDROID
*/

window.addEventListener(
  "orientationchange",
  () => {

    setTimeout(() => {
      checkOrientation();
    }, 150);

  }
);

window.addEventListener(
  "resize",
  () => {

    setTimeout(() => {
      checkOrientation();
    }, 150);

  }
);
</script>
