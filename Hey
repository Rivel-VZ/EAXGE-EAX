<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EAXGE EAX</title>

<style>
body {
  margin: 0;
  background: #000000;
  color: #f0f0f0;
  font-family: system-ui, sans-serif;
  display: grid;
  place-items: center;
  min-height: 100vh;
  text-align: center;
  transition: background 0.3s;
}

main {
  padding: 30px;
}

h1 {
  font-size: 48px;
  margin-bottom: 20px;
}

p {
  margin: 12px 0;
  opacity: 0.10;
}

#clue {
  margin-top: 25px;
}
</style>
</head>

<body>

<main>
  <h1>☀</h1>

  <p id="status">can YOU prove it.</p>

  <p id="clue">wrong</p>
</main>

<script>

const DRIVE_1 =
"https://drive.google.com/drive/folders/1valQtwpUoLt5QxvNnAakI_NV4Si_K7vv2_ZXUbYL1OomYRB6t1O0kuFBXlix7EoZ49U4brI3";

const DRIVE_2 =
"https://drive.google.com/drive/folders/1vCzFLpL1ckXtT_gsUeu6teF2Yjxga9_q";

const status = document.getElementById("status");
const clue = document.getElementById("clue");

let firstLoad = true;
let redirected = false;

function checkOrientation() {

  const angle = screen.orientation?.angle ?? 0;

  console.log("ANGLE:", angle);

  /*
    PC
  */
  if (!("ontouchstart" in window) && !navigator.maxTouchPoints) {
    clue.textContent = "...";
    return;
  }

  /*
    HP TEGAK
  */
  if (angle === 0 || angle === 180) {

    status.textContent = "can YOU prove it.";
    clue.textContent = "wrong";

    document.body.style.background = "#000000";

    return;
  }

  /*
    HP MIRING
  */
  if (angle === 270 || angle === 90) {

    status.textContent = "can YOU price it";
    clue.textContent = "wrong";

    document.body.style.background = "#5D0D02";

    /*
      Jangan redirect saat pertama kali halaman dibuka.
      Redirect hanya setelah HP benar-benar berubah orientasi.
    */

    if (!firstLoad && !redirected) {

      redirected = true;

      setTimeout(() => {
        window.location.href = DRIVE_2;
      }, 700);

    }
  }
}


/*
  Jalankan sekali saat halaman dibuka,
  tapi BELUM boleh redirect.
*/

checkOrientation();

firstLoad = false;


/*
  Deteksi HP diputar
*/

if (screen.orientation) {

  screen.orientation.addEventListener(
    "change",
    checkOrientation
  );

}


/*
  Cadangan untuk perubahan ukuran layar
*/

window.addEventListener(
  "resize",
  () => {

    setTimeout(checkOrientation, 100);

  }
);

</script>

</body>
</html>
